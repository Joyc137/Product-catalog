# --- Server ---
NODE_ENV=development
PORT=5000

# Local:  mongodb://127.0.0.1:27017/product-catalog
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/product-catalog
MONGODB_URI=mongodb://127.0.0.1:27017/product-catalog

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=2h

# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

BCRYPT_ROUNDS=12

# --- Seed script (npm run seed) ---
SEED_COUNT=50000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-Admin123
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=change-me-User123
