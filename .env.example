# Used by docker-compose.yml only. For running the server directly, see server/.env.example.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=2h

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-Admin123
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=change-me-User123
